<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.1-001-1-mysql-add-first-name-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="first_name"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="first_name" type="VARCHAR(255)"/>
    </addColumn>
  </changeSet>

  <changeSet id="1.1-001-2-mysql-add-last-name-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="last_name"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="last_name" type="VARCHAR(255)"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
