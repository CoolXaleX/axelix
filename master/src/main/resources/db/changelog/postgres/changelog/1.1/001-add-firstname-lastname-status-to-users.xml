<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.1-001-1-postgres-add-first-name-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="first_name"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="first_name" type="TEXT"/>
    </addColumn>
  </changeSet>

  <changeSet id="1.1-001-2-postgres-add-last-name-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="last_name"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="last_name" type="TEXT"/>
    </addColumn>
  </changeSet>

  <changeSet id="1.1-001-3-postgres-add-status-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="status"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="status" type="TEXT" defaultValue="ACTIVE">
        <constraints nullable="false" checkConstraint="status IN ('ACTIVE', 'SUSPENDED')"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="1.1-001-4-postgres-add-job-title-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="job_title"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="job_title" type="TEXT"/>
    </addColumn>
  </changeSet>

  <changeSet id="1.1-001-5-postgres-add-organizational-unit-to-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="users" columnName="organizational_unit"/>
      </not>
    </preConditions>

    <addColumn tableName="users">
      <column name="organizational_unit" type="TEXT"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
